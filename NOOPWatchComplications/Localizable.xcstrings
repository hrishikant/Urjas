    "Ūrjas. Scores out of date, last synced %@. Open Ūrjas on iPhone to refresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ūrjas. Werte veraltet, zuletzt synchronisiert %@. Öffne Ūrjas auf dem iPhone zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ūrjas. Scores out of date, last synced %@. Open Ūrjas on iPhone to refresh."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Pontuações desatualizadas, última sincronização %@. Abra o Ūrjas no iPhone para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ūrjas. Показатели устарели, последняя синхронизация %@. Откройте Ūrjas на iPhone, чтобы обновить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ūrjas. Resultados fuera de la fecha, último sincronizado %1$@. Abra Ūrjas en iPhone para refrescarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Les scores sont dépassés, le dernier %1$@ synchronisé. Ouvrez Ūrjas sur iPhone pour vous rafraîchir."
          }
